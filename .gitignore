# ==============================================================================
# Git Ignore - Clean Production Code Only (纯生产代码轻量化交付)
# 排除临时文档/报告、临时脚本与编译构建产物；README、许可证、计划与验收 HTML 单独保留
# ==============================================================================

# ── 1. 文档与手册文件 (保留 LICENSE、README.md、USAGE.md 与 skills 技能文档) ─────
*.md
!README.md
!USAGE.md
!skills/**/*.md
*.markdown
*.pdf
docs/
*.txt
!requirements.txt
!LICENSE*

# ── 2. 测试工程与临时脚本 (保留标准单元测试 tests/，排除临时草稿与审计扫描) ──────────
scratch/
audit/
scans/

# ── 3. 大文件构建产物与临时产物 (排除 574MB 垃圾二进制与编译对象) ─────────────
output/
dist/
build/
saves/
target/
dist_package/
attic/
*.exe
*.o
*.obj
*.rlib
*.rmeta
*.dll
*.so
*.dylib
*.timestamp
*.pdb

# ── 4. 媒体与临时截图 (保留代码中以文本形式内嵌的资产) ────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ogg
*.wav
*.mp3
*.mp4
*.zip
*.tar.gz
*.7z

# ── 5. Python 字节码与虚拟环境 ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ── 6. 操作系统与临时日志 ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp
*.log
logs/
tmp_edge_*/
wechat_article_dump.*
parsed_games_db.json
.env

# LLM 端点池（含密钥，禁止提交）
config/llm_endpoints.json
