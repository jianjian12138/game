# ==============================================================================
# Git Ignore - Clean Production Code Only (纯生产代码轻量化交付)
# 排除所有文档文件 (*.md)、测试文件 (test_*.py)、临时脚本与 574MB 编译构建产物
# ==============================================================================

# ── 1. 文档与手册文件 (按甲方验收与用户指令：不上传任何文档) ───────────────────
*.md
*.markdown
*.pdf
docs/
USAGE*
LICENSE*
*.txt
!requirements.txt

# ── 2. 测试与冒烟脚本 (按用户指令：不上传任何测试文件) ─────────────────────────
test_*.py
*_test.py
tests/
scratch/
audit/
scans/

# ── 3. 大文件构建产物与临时产物 (排除 574MB 垃圾二进制与编译对象) ─────────────
output/
dist/
build/
saves/
target/
*.exe
*.o
*.obj
*.rlib
*.rmeta
*.dll
*.so
*.dylib
*.timestamp
*.pdb

# ── 4. 媒体与临时截图 (保留代码中以文本形式内嵌的资产) ────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ogg
*.wav
*.mp3
*.mp4
*.zip
*.tar.gz
*.7z

# ── 5. Python 字节码与虚拟环境 ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ── 6. 操作系统与临时日志 ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp
*.log
tmp_edge_*/
wechat_article_dump.*
parsed_games_db.json
.env
