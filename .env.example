# =================================================================
# Game-Agent 环境配置填写指南 (.env.example)
#
# 三步上手：
#   1) cp .env.example .env
#   2) 按下面分组填写（不用的组保持注释即可，不用删）
#   3) python game_agent.py env-check        # 自检，看还差什么（退出码 0=齐备）
#
# ★ 运行模式：本文件大部分内容你现在都不用填 ★
#   local（默认）—— 只开发游戏：只要「2. LLM 端点」就能开工，
#                   第 4/5/6 组的渠道、沙箱、Staging、遥测一概不看、不阻塞。
#                   python game_agent.py autonomous --title "xxx" --run-mode local
#   platform     —— 真实上架与线上运营：才需要第 4/5/6 组，缺一项就明确拦下。
#                   python game_agent.py autonomous --title "xxx" --run-mode platform
#   一句话：先本地把游戏做出来（第 2 组就够），要上架了再来填 4/5/6。
#
# 安全：.env 与 config/llm_endpoints.json 都已被 .gitignore 忽略，
#      不会进 git，也不会进交付物。但仍然不要把它发给别人。
#
# 说明：所有值都只被读取使用，任何体检命令都不会打印凭据内容，
#      只报「是否设置 / 格式是否合法 / 探测是否通过」。
# =================================================================

# ── 0. 运行模式（可选；不填就是 local，即纯本地开发） ────────────────────────
# local    = 本地开发，不要求任何渠道/线上配置（推荐先用这个）
# platform = 平台对接，要求渠道凭据 + 三类沙箱 + Staging + 遥测齐全
# 也可在命令行用 --run-mode 覆盖，命令行优先级更高。
# GAME_RUN_MODE=local

# ── 1. 基础运行（一般不用改） ────────────────────────────────────────────────
GAME_STUDIO_HOST=127.0.0.1
GAME_STUDIO_PORT=8090
GAME_STUDIO_TOKEN=
# 运行环境模式：sandbox | staging | production
GAME_ENVIRONMENT=sandbox

# ── 2. LLM 端点（可选；未配置时自动降级为本地模板模式，不会伪造 LLM 产出） ────
# 获取地址：
#   Gemini    https://aistudio.google.com/app/apikey
#   OpenAI    https://platform.openai.com/api-keys
#   Claude    https://console.anthropic.com/settings/keys
#   DeepSeek  https://platform.deepseek.com/api_keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Ollama 本地推理（无需 Key，完全离线）
# OLLAMA_BASE_URL=http://localhost:11434
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODE=hybrid
LLM_TIMEOUT=60
LLM_MAX_TOKENS=8192
LLM_AUTO_FALLBACK=true

# ── 3. 本地工具链（Agent 自动探测，一般不填；换机器/换端口才需要） ───────────
# ComfyUI 出图服务地址（AIGC 美术后端）。默认 8188，换端口请改这里。
# 验证：python game_agent.py env-check   ->  ComfyUI 出图服务 = OK
# COMFYUI_URL=http://127.0.0.1:8188
# Godot 可执行文件（Godot 目标需要；Web 主线不强依赖）
# GODOT_PATH=D:/Godot/Godot_v4.7.2-stable_win64.exe
# 浏览器（真实试玩用；留空自动探测 Edge/Chromium）
# CHROMIUM_PATH=

# ── 4. 缺口① 外部渠道上架凭据 ────────────────────────────────────────────────
# 填完自检：python game_agent.py channel-doctor
#
# 微信小游戏（另需 npm i -g miniprogram-ci）
#   AppID 格式：wx + 16 位小写十六进制（微信公众平台后台可见）
#   私钥：mp 后台 开发管理 -> 开发设置 -> 小程序代码上传密钥 -> 下载 private.key
WECHAT_APPID=
WECHAT_CI_KEY_PATH=
# Steam（另需安装 steamcmd；AppID 必须是纯数字）
STEAM_USER=
STEAM_APP_ID=
# itch.io（另需安装 butler 并执行 butler login；格式必须是 user/game）
ITCH_BUTLER_TARGET=
# Web PWA 部署基址（必须是 https）
PWA_DEPLOY_BASE_URL=

# ── 5. 缺口② 线上服务沙箱与 Staging ──────────────────────────────────────────
# 【仅 platform 模式需要；本地开发可整段跳过】
# 填完自检：python game_agent.py live-doctor      # 探活（端点活着吗）
#          python game_agent.py live-flow         # 业务链路（下单/广告/建房能跑通吗）
#
# 拿不到真服务商凭据也能先跑通：本仓库自带可运行的参考服务端
#   python -m pipeline.live_service_reference --all \
#       --payment-key <自定> --ads-key <自定> --multiplayer-key <自定>
#   # 会起在 8801/8802/8803 并打印该填什么，照抄到下面即可
#   然后：python game_agent.py live-flow          # 三类链路全绿
# 换成真服务商时只改下面 URL+KEY，业务代码不用动。
#
# 重要：服务端必须暴露 /health 并自报家门，否则只连通也不算可用：
#   GET /health -> {"service": "payment", "status": "ok", "environment": "sandbox"}
#   service 取值：payment / ads / multiplayer / game（Staging 用 game）
#   environment 取值：sandbox（沙箱）或 staging（Staging）
# 参考实现：python game_agent.py live-doctor --emit-reference ./health_server
#
# 远端必须 https；明文 http 仅允许 127.0.0.1 本机联调。
# 支付沙箱（下单/退款/对账）
PAYMENT_SANDBOX_URL=
PAYMENT_SANDBOX_KEY=
# 广告沙箱（激励视频/插屏/banner 填充）
ADS_SANDBOX_URL=
ADS_SANDBOX_KEY=
# 联机沙箱（匹配/房间/中继）
MULTIPLAYER_SANDBOX_URL=
MULTIPLAYER_SANDBOX_KEY=
# Staging 预发布环境（Preview -> Staging 晋升前会真实访问；未配置一律拒绝晋升）
STAGING_BASE_URL=

# ── 6. 缺口④ 真实玩家遥测 ────────────────────────────────────────────────────
# 填完自检：python game_agent.py player-doctor
#
# 遥测服务 /health 需返回 {"service": "telemetry", "status": "ok", "environment": "..."}
TELEMETRY_ENDPOINT=
TELEMETRY_KEY=
#
# 客户端埋点必须带来源标记，否则不计入真实指标：
#   {"user_id": "p1", "event_name": "level_start", "timestamp": 1757500000,
#    "properties": {"source": "real_player"}}
#   source 取值 real_player / playtest / beta / store / live 才算真实；
#   simulated / synthetic / bot / mock 记为模拟，不得用于对外宣称留存/付费/时长。

# ── 附：复核工单目录（可选，多环境并存时用于隔离） ──────────────────────────
# GAME_REVIEW_ROOT=
# GAME_PLAYER_VALIDATION_ROOT=
