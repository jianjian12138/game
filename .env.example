# =================================================================
# Antigravity Game-Agent 环境配置模板 (.env.example)
# 请复制本文件为 .env 并根据本地环境调整，切勿将真实密钥提交至 Git
# =================================================================

# 1. Web 控制台与服务配置
GAME_STUDIO_HOST=127.0.0.1
GAME_STUDIO_PORT=8090
GAME_STUDIO_TOKEN=

# 2. 外部工具链自定义路径 (可选，留空则由系统自动探测)
CHROMIUM_PATH=
GODOT_PATH=

# 3. 运行环境模式 (sandbox | staging | production)
GAME_ENVIRONMENT=sandbox
