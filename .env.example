# Game Dev Agent Studio v5.0 — API Key 配置模板
# 复制此文件为 .env，填入你的 API Key，Agent 将自动读取

# ── Google Gemini（推荐：免费额度最高，支持 2.0 Flash / 2.5 Pro）──────────────
# 获取地址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenAI GPT-4o / GPT-4.1 ──────────────────────────────────────────────────
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Anthropic Claude Sonnet / Opus ────────────────────────────────────────────
# 获取地址: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── DeepSeek（国内访问友好，成本极低，兼容 OpenAI 协议）─────────────────────
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Ollama 本地（无需 API Key，完全离线）─────────────────────────────────────
# 默认地址 http://localhost:11434，如需修改请取消注释：
# OLLAMA_BASE_URL=http://localhost:11434

# ── 全局 LLM 配置 ─────────────────────────────────────────────────────────────
# 默认 Provider（未在命令行指定 --llm-provider 时使用）
# 可选值: gemini | openai | claude | deepseek | ollama | auto
LLM_DEFAULT_PROVIDER=gemini

# 默认生成模式（未在命令行指定 --mode 时使用）
# 可选值: fast（纯模板，零延迟） | llm（LLM 生成） | hybrid（模板+LLM增强）
LLM_DEFAULT_MODE=hybrid

# LLM 请求超时（秒）
LLM_TIMEOUT=60

# 代码生成最大 Token 数
LLM_MAX_TOKENS=8192

# 是否启用 Provider 自动降级（主力 → 备用，任一失败时自动切换）
LLM_AUTO_FALLBACK=true
